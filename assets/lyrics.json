[
  {
    "t": 0.0,
    "text": "",
    "kind": "beat"
  },
  {
    "t": 13.74,
    "text": "Deus abençoou a casa",
    "kind": "line"
  },
  {
    "t": 17.14,
    "text": "Com oitenta anos de história",
    "kind": "line"
  },
  {
    "t": 21.48,
    "text": "Um pai de alma bonita",
    "kind": "line"
  },
  {
    "t": 23.46,
    "text": "Vivendo desafios e muita glória",
    "kind": "line"
  },
  {
    "t": 26.94,
    "text": "Veio de família grande",
    "kind": "line"
  },
  {
    "t": 30.22,
    "text": "Sete irmãos, muitos sobrinhos",
    "kind": "line"
  },
  {
    "t": 33.98,
    "text": "Todos venceram na vida",
    "kind": "line"
  },
  {
    "t": 36.78,
    "text": "É orgulho nos olhos sorrindo",
    "kind": "line"
  },
  {
    "t": 40.94,
    "text": "Casou jovem com Marilena",
    "kind": "line"
  },
  {
    "t": 44.2,
    "text": "E fez do amor seu lugar",
    "kind": "line"
  },
  {
    "t": 46.9,
    "text": "Quatro filhos, uma família",
    "kind": "line"
  },
  {
    "t": 50.5,
    "text": "Que aprendeu a se amar",
    "kind": "line"
  },
  {
    "t": 54.44,
    "text": "Luciana, Fabrício, Daniela e Breno",
    "kind": "line"
  },
  {
    "t": 57.58,
    "text": "São pedaços do seu coração",
    "kind": "line"
  },
  {
    "t": 60.56,
    "text": "E em cada conquista da vida",
    "kind": "line"
  },
  {
    "t": 63.8,
    "text": "Tem sua mão, sua oração",
    "kind": "line"
  },
  {
    "t": 68.2,
    "text": "Pai, sua voz contando histórias",
    "kind": "line"
  },
  {
    "t": 71.7,
    "text": "Faz o tempo se ajoelhar",
    "kind": "line"
  },
  {
    "t": 75.06,
    "text": "Cada lembrança vira festa",
    "kind": "line"
  },
  {
    "t": 77.36,
    "text": "Quando a família vem se juntar",
    "kind": "line"
  },
  {
    "t": 81.42,
    "text": "Antônio Marinho, nosso pai, nosso chão",
    "kind": "chorus"
  },
  {
    "t": 84.34,
    "text": "Conselheiro, abrigo, amor e direção",
    "kind": "chorus"
  },
  {
    "t": 87.66,
    "text": "Deus foi generoso em te deixar aqui",
    "kind": "chorus"
  },
  {
    "t": 90.86,
    "text": "Pra gente aprender o que é família e sorrir",
    "kind": "chorus"
  },
  {
    "t": 94.18,
    "text": "Pai, que orgulho te cantar",
    "kind": "chorus"
  },
  {
    "t": 97.04,
    "text": "Oitenta anos de vida pra gente celebrar",
    "kind": "chorus"
  },
  {
    "t": 100.56,
    "text": "Que venha saúde, que venha vida longa",
    "kind": "chorus"
  },
  {
    "t": 103.58,
    "text": "Porque nossa maior festa é ter você para amar",
    "kind": "chorus"
  },
  {
    "t": 110.68,
    "text": "Tem cheiro de natureza",
    "kind": "line"
  },
  {
    "t": 113.36,
    "text": "Tem sítio, encontro e quintal",
    "kind": "line"
  },
  {
    "t": 116.76,
    "text": "Tem os galos que herdou do seu pai",
    "kind": "line"
  },
  {
    "t": 119.64,
    "text": "Cantando no mesmo sinal",
    "kind": "line"
  },
  {
    "t": 123.4,
    "text": "E quando fala de bola",
    "kind": "line"
  },
  {
    "t": 125.8,
    "text": "O peito volta a vibrar",
    "kind": "line"
  },
  {
    "t": 129.26,
    "text": "Mafinha, Fazendário e Muirakitã",
    "kind": "line"
  },
  {
    "t": 132.2,
    "text": "E os gols que muitos viram passar",
    "kind": "line"
  },
  {
    "t": 135.42,
    "text": "Artilheiro que o mundo não conheceu",
    "kind": "line"
  },
  {
    "t": 138.86,
    "text": "Defesas que o tempo guardou",
    "kind": "line"
  },
  {
    "t": 141.8,
    "text": "Histórias contadas mil vezes",
    "kind": "line"
  },
  {
    "t": 144.88,
    "text": "Com detalhes e risos de amor",
    "kind": "line"
  },
  {
    "t": 148.5,
    "text": "É apaixonado pelo Fluminense",
    "kind": "line"
  },
  {
    "t": 152.04,
    "text": "É Tricolor com gratidão",
    "kind": "line"
  },
  {
    "t": 154.84,
    "text": "Tem alma verde, grená e branco",
    "kind": "line"
  },
  {
    "t": 158.0,
    "text": "Pra alegrar seu coração",
    "kind": "line"
  },
  {
    "t": 161.8,
    "text": "E a turma do Dominó",
    "kind": "line"
  },
  {
    "t": 163.67,
    "text": "Tem muitos amigos pra animar",
    "kind": "line"
  },
  {
    "t": 168.4,
    "text": "Com suas jogadas de mestre",
    "kind": "line"
  },
  {
    "t": 171.09,
    "text": "Ensina todos a jogar",
    "kind": "line"
  },
  {
    "t": 174.15,
    "text": "Cada partida tem história",
    "kind": "line"
  },
  {
    "t": 177.23,
    "text": "Cada rodada, uma emoção",
    "kind": "line"
  },
  {
    "t": 180.43,
    "text": "Entre risadas e brincadeiras",
    "kind": "line"
  },
  {
    "t": 183.65,
    "text": "Amizade é a melhor pontuação",
    "kind": "line"
  },
  {
    "t": 188.8,
    "text": "Uma vida de serviço",
    "kind": "line"
  },
  {
    "t": 190.79,
    "text": "Da primeira turma do NPOR",
    "kind": "line"
  },
  {
    "t": 194.17,
    "text": "Veio a honra que nunca se apaga",
    "kind": "line"
  },
  {
    "t": 196.77,
    "text": "Tenente Marinho era o nome de guerra",
    "kind": "line"
  },
  {
    "t": 199.15,
    "text": "E sua carteira de oficial da reserva ainda o alegra",
    "kind": "line"
  },
  {
    "t": 203.75,
    "text": "Funabem, Codeama",
    "kind": "line"
  },
  {
    "t": 205.85,
    "text": "Universidade Federal do Amazonas e do Espírito Santo",
    "kind": "line"
  },
  {
    "t": 209.5,
    "text": "E Secretaria da Fazenda",
    "kind": "line"
  },
  {
    "t": 211.8,
    "text": "Por onde passou fez amigos",
    "kind": "line"
  },
  {
    "t": 214.0,
    "text": "E amigos nunca foram demais",
    "kind": "line"
  },
  {
    "t": 218.07,
    "text": "Matheus, Lucas, Letícia e Yasmin",
    "kind": "line"
  },
  {
    "t": 221.2,
    "text": "Lena, Gabriela, Isabela também",
    "kind": "line"
  },
  {
    "t": 224.4,
    "text": "Benício e Maria Fernanda",
    "kind": "line"
  },
  {
    "t": 227.4,
    "text": "Têm no vô um porto do bem",
    "kind": "line"
  },
  {
    "t": 230.81,
    "text": "Genros, noras, esposos",
    "kind": "line"
  },
  {
    "t": 232.8,
    "text": "E esposa dos netos também",
    "kind": "line"
  },
  {
    "t": 234.67,
    "text": "Vinte e um corações num só laço",
    "kind": "line"
  },
  {
    "t": 237.8,
    "text": "Que fazem essa família ir além",
    "kind": "line"
  },
  {
    "t": 240.4,
    "text": "Nas festas que a mamãe prepara",
    "kind": "line"
  },
  {
    "t": 243.0,
    "text": "Nas viagens, no sítio, nosso eterno abraço",
    "kind": "line"
  },
  {
    "t": 246.4,
    "text": "Em cada encontro, uma lembrança",
    "kind": "line"
  },
  {
    "t": 249.4,
    "text": "Em cada sorriso, um pedaço",
    "kind": "line"
  },
  {
    "t": 252.2,
    "text": "São sessenta e dois anos de união",
    "kind": "line"
  },
  {
    "t": 255.51,
    "text": "Cinquenta e sete de casados",
    "kind": "line"
  },
  {
    "t": 258.4,
    "text": "E cinco anos de namoro",
    "kind": "line"
  },
  {
    "t": 261.4,
    "text": "E você ainda lembra com sorrisos",
    "kind": "line"
  },
  {
    "t": 265.4,
    "text": "Dos “Três anos cercando o louro”",
    "kind": "line"
  },
  {
    "t": 270.71,
    "text": "Marilena ao seu lado é promessa",
    "kind": "line"
  },
  {
    "t": 273.8,
    "text": "De amor que venceu estações",
    "kind": "line"
  },
  {
    "t": 277.2,
    "text": "E nós agradecemos a Deus",
    "kind": "line"
  },
  {
    "t": 280.4,
    "text": "Por guardar nossas gerações",
    "kind": "line"
  },
  {
    "t": 284.61,
    "text": "Antônio Marinho, nosso pai, nosso chão",
    "kind": "chorus"
  },
  {
    "t": 287.83,
    "text": "Conselheiro, abrigo, amor e direção",
    "kind": "chorus"
  },
  {
    "t": 290.83,
    "text": "Deus foi generoso em te deixar aqui",
    "kind": "chorus"
  },
  {
    "t": 294.2,
    "text": "Pra gente aprender o que é família e sorrir",
    "kind": "chorus"
  },
  {
    "t": 297.43,
    "text": "Pai, que orgulho te cantar",
    "kind": "chorus"
  },
  {
    "t": 300.21,
    "text": "Oitenta anos de vida pra gente celebrar",
    "kind": "chorus"
  },
  {
    "t": 303.69,
    "text": "Que venha saúde, que venha vida longa",
    "kind": "chorus"
  },
  {
    "t": 306.9,
    "text": "Porque nossa maior festa é ter você para amar",
    "kind": "chorus"
  },
  {
    "t": 314.45,
    "text": "Da parte da sua família",
    "kind": "final"
  },
  {
    "t": 317.0,
    "text": "Com gratidão em cada oração",
    "kind": "final"
  },
  {
    "t": 320.41,
    "text": "Amamos você, pai querido",
    "kind": "final"
  },
  {
    "t": 323.27,
    "text": "Para sempre em nosso coração",
    "kind": "final"
  },
  {
    "t": 327.43,
    "text": "Oitenta anos de histórias",
    "kind": "final"
  },
  {
    "t": 330.83,
    "text": "Oitenta anos de emoção",
    "kind": "final"
  },
  {
    "t": 333.69,
    "text": "Antônio Marinho, nosso pai",
    "kind": "final"
  },
  {
    "t": 336.43,
    "text": "Nossa família, nossa união",
    "kind": "final"
  },
